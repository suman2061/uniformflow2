model DeliveryLine {
  id           String   @id @default(uuid())
  businessId   String
  deliveryId   String
  productId    String
  productName  String
  size         String   @default("")
  qtyRequired  Int      @default(0)
  qtyDelivered Int      @default(0)
  qtyReturned  Int      @default(0)
  isDemoData   Boolean  @default(false)
  createdAt    DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([productId])
}

model Invoice {
  id             String    @id @default(uuid())
  businessId     String
  invoiceNumber  String
  schoolId       String
  academicYearId String
  invoiceDate    DateTime  @default(now())
  dueDate        DateTime?
  subtotal       Decimal   @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal   @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal   @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal   @default(0) @db.Decimal(12, 2)
  status         String    @default("DRAFT")
  notes          String?
  createdById    String?
  isDemoData     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines       InvoiceLine[]
  allocations PaymentAllocation[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId, schoolId])
  @@index([businessId, status])
}

model InvoiceLine {
  id          String  @id @default(uuid())
  businessId  String
  invoiceId   String
  description String
  productId   String?
  quantity    Int     @default(0)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @default(0) @db.Decimal(12, 2)
  isDemoData  Boolean @default(false)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([invoiceId])
}

model Payment {
  id             String   @id @default(uuid())
  businessId     String
  schoolId       String
  invoiceId      String?
  type           String   @default("PARTIAL")
  method         String   @default("CASH")
  amount         Decimal  @db.Decimal(12, 2)
  transactionRef String?
  paymentDate    DateTime @default(now())
  notes          String?
  receivedById   String?
  isDemoData     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  allocations PaymentAllocation[]

  @@index([businessId, schoolId])
  @@index([invoiceId])
}

model PaymentAllocation {
  id         String   @id @default(uuid())
  businessId String
  paymentId  String
  invoiceId  String?
  studentId  String?
  amount     Decimal  @db.Decimal(12, 2)
  isDemoData Boolean  @default(false)
  createdAt  DateTime @default(now())

  payment Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([businessId])
  @@index([paymentId])
  @@index([invoiceId])
  @@index([studentId])
}

model Notification {
  id              String    @id @default(uuid())
  businessId      String
  recipientUserId String?
  type            String
  title           String
  body            String?
  payload         Json?
  readAt          DateTime?
  isDemoData      Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([businessId, recipientUserId])
  @@index([businessId, createdAt])
}

// ============================================================
// PHASE 4 — SAAS MONETIZATION
// ============================================================

model Plan {
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String   @unique
  monthlyPrice Decimal  @default(0) @db.Decimal(12, 2)
  annualPrice  Decimal  @default(0) @db.Decimal(12, 2)
  trialDays    Int      @default(14)
  maxSchools   Int      @default(0)
  maxUsers     Int      @default(0)
  maxStudents  Int      @default(0)
  storageMb    Int      @default(0)
  features     Json?
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  isDemoData   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id               String    @id @default(uuid())
  businessId       String    @unique
  business         Business  @relation(fields: [businessId], references: [id])
  planId           String
  status           String    @default("trial")
  billingCycle     String    @default("monthly")
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  billingProvider  String?
  billingRef       String?
  cancelAtPeriodEnd Boolean  @default(false)
  isDemoData       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  plan Plan @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([planId])
}

model BillingEvent {
  id          String   @id @default(uuid())
  businessId  String?
  provider    String
  eventType   String
  externalId  String   @unique
  payload     Json?
  processedAt DateTime @default(now())

  @@index([businessId])
}
