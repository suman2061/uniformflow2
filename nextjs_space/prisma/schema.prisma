model Order {
  id                   String    @id @default(uuid())
  businessId           String
  orderNumber          String
  schoolId             String
  academicYearId       String
  studentId            String?
  orderType            String    @default("SCHOOL")
  status               String    @default("REQUIREMENT_COLLECTION")
  orderDate            DateTime  @default(now())
  expectedDeliveryDate DateTime?
  notes                String?
  subtotal             Decimal   @default(0) @db.Decimal(12, 2)
  discountTotal        Decimal   @default(0) @db.Decimal(12, 2)
  taxTotal             Decimal   @default(0) @db.Decimal(12, 2)
  grandTotal           Decimal   @default(0) @db.Decimal(12, 2)
  statusHistory        Json?
  createdById          String?
  isDemoData           Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  lines OrderLine[]

  @@unique([businessId, orderNumber])
  @@index([businessId, schoolId])
  @@index([businessId, academicYearId])
  @@index([businessId, status])
  @@index([studentId])
}

model OrderLine {
  id           String   @id @default(uuid())
  businessId   String
  orderId      String
  productId    String
  productName  String
  size         String   @default("")
  quantity     Int      @default(0)
  approvedQty  Int      @default(0)
  cancelledQty Int      @default(0)
  deliveredQty Int      @default(0)
  unitPrice    Decimal  @db.Decimal(12, 2)
  discount     Decimal  @default(0) @db.Decimal(12, 2)
  taxRate      Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal    Decimal  @default(0) @db.Decimal(12, 2)
  isDemoData   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId, size])
  @@index([businessId])
  @@index([productId])
}

model FabricRequirement {
  id                 String   @id @default(uuid())
  businessId         String
  academicYearId     String
  productId          String
  productName        String
  size               String   @default("")
  totalQuantity      Int      @default(0)
  consumptionPerUnit Decimal  @default(0) @db.Decimal(10, 3)
  wastagePercent     Decimal  @default(0) @db.Decimal(5, 2)
  fabricType         String?
  fabricRequired     Decimal  @default(0) @db.Decimal(12, 3)
  manualAdjustment   Decimal  @default(0) @db.Decimal(12, 3)
  adjustmentReason   String?
  isDemoData         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([businessId, academicYearId])
  @@index([productId])
}

model PurchaseOrder {
  id                   String    @id @default(uuid())
  businessId           String
  poNumber             String
  supplierName         String
  supplierContact      String?
  fabricType           String?
  quantity             Decimal   @default(0) @db.Decimal(12, 3)
  unit                 String    @default("METERS")
  unitCost             Decimal   @default(0) @db.Decimal(12, 2)
  totalCost            Decimal   @default(0) @db.Decimal(12, 2)
  receivedQty          Decimal   @default(0) @db.Decimal(12, 3)
  status               String    @default("DRAFT")
  orderDate            DateTime  @default(now())
  expectedDeliveryDate DateTime?
  notes                String?
  createdById          String?
  isDemoData           Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  receipts FabricReceipt[]

  @@unique([businessId, poNumber])
  @@index([businessId, status])
}

model FabricReceipt {
  id              String   @id @default(uuid())
  businessId      String
  purchaseOrderId String
  receivedQty     Decimal  @default(0) @db.Decimal(12, 3)
  shortageQty     Decimal  @default(0) @db.Decimal(12, 3)
  receivedDate    DateTime @default(now())
  notes           String?
  receivedById    String?
  isDemoData      Boolean  @default(false)
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([purchaseOrderId])
}

model ProductionBatch {
  id                String    @id @default(uuid())
  businessId        String
  academicYearId    String
  productId         String
  productName       String
  size              String    @default("")
  plannedQty        Int       @default(0)
  cuttingQty        Int       @default(0)
  stitchingQty      Int       @default(0)
  completedQty      Int       @default(0)
  defectiveQty      Int       @default(0)
  reworkQty         Int       @default(0)
  status            String    @default("PLANNED")
  qcStatus          String?
  worker            String?
  vendor            String?
  plannedCompletion DateTime?
  actualCompletion  DateTime?
  notes             String?
  isDemoData        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([businessId, academicYearId])
  @@index([businessId, status])
  @@index([productId])
}

model Delivery {
  id             String   @id @default(uuid())
  businessId     String
  challanNumber  String
  schoolId       String
  academicYearId String
  studentId      String?
  orderId        String?
  recipientName  String?
  status         String   @default("PENDING")
  deliveryDate   DateTime @default(now())
  proofFileUrl   String?
  notes          String?
  createdById    String?
  isDemoData     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines DeliveryLine[]

  @@unique([businessId, challanNumber])
  @@index([businessId, schoolId])
  @@index([businessId, status])
