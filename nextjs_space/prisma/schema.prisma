datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Business {
  id             String   @id @default(uuid())
  name           String
  code           String   @unique
  address        String?
  phone          String?
  email          String?
  logoUrl        String?
  status         String   @default("active")
  isDemoData     Boolean  @default(false)
  nextStudentSeq Int      @default(0)
  nextOrderSeq   Int      @default(0)
  nextPoSeq      Int      @default(0)
  nextChallanSeq Int      @default(0)
  nextInvoiceSeq Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users           User[]
  schools         School[]
  students        Student[]
  enrollments     Enrollment[]
  products        Product[]
  schoolProducts  SchoolProduct[]
  academicYears   AcademicYear[]
  schoolClasses   SchoolClass[]
  schoolDivisions SchoolDivision[]
  auditLogs       AuditLog[]
  measurementSubmissions MeasurementSubmission[]
  measurements           Measurement[]
  measurementHistories   MeasurementHistory[]
  subscription           Subscription?
}

model User {
  id           String   @id @default(uuid())
  businessId   String?
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         String
  permissions  Json?
  active       Boolean  @default(true)
  isDemoData   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business? @relation(fields: [businessId], references: [id])
  verifiedMeasurements MeasurementSubmission[] @relation("MeasurementVerifier")

  @@index([businessId])
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String?
  userId     String
  userName   String
  action     String
  entityType String
  entityId   String?
  summary    String
  changes    Json?
  ip         String?
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id])

  @@index([businessId, entityType, createdAt])
  @@index([businessId, createdAt])
  @@index([userId])
}

model School {
  id             String   @id @default(uuid())
  businessId     String
  name           String
  code           String
  address        String?
  phone          String?
  email          String?
  contactPerson  String?
  billingName    String?
  billingAddress String?
  gstin          String?
  logoUrl        String?
  active         Boolean  @default(true)
  isDemoData     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id])
  academicYears   AcademicYear[]
  schoolClasses   SchoolClass[]
  schoolDivisions SchoolDivision[]
  students        Student[]
  enrollments     Enrollment[]
  schoolProducts  SchoolProduct[]
  measurementSubmissions MeasurementSubmission[]

  @@unique([businessId, code])
  @@index([businessId, name])
  @@index([businessId, active])
}

model AcademicYear {
  id                     String    @id @default(uuid())
  businessId             String
  schoolId               String
  name                   String
  startsOn               DateTime?
  endsOn                 DateTime?
  isActive               Boolean   @default(true)
  measurementWindowStart DateTime?
  measurementWindowEnd   DateTime?
  measurementSettings    Json?
  isDemoData             Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  business       Business       @relation(fields: [businessId], references: [id])
  school         School         @relation(fields: [schoolId], references: [id])
  enrollments    Enrollment[]
  schoolProducts SchoolProduct[]
  measurementSubmissions MeasurementSubmission[]
  measurements           Measurement[]

  @@unique([businessId, schoolId, name])
  @@index([schoolId, isActive])
  @@index([businessId])
}

model SchoolClass {
  id         String   @id @default(uuid())
  businessId String
  schoolId   String
  name       String
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  isDemoData Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  school      School       @relation(fields: [schoolId], references: [id])
  enrollments Enrollment[]

  @@unique([businessId, schoolId, name])
  @@index([businessId, schoolId])
}

model SchoolDivision {
  id         String   @id @default(uuid())
  businessId String
  schoolId   String
  name       String
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  isDemoData Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  school      School       @relation(fields: [schoolId], references: [id])
  enrollments Enrollment[]

  @@unique([businessId, schoolId, name])
  @@index([businessId, schoolId])
}

model Student {
  id              String   @id @default(uuid())
  businessId      String
  schoolId        String
  permanentId     String
  name            String
  gender          String?
  uniformCategory String?
  parentName      String?
  parentPhone     String?
  parentEmail     String?
  status          String   @default("active")
  notes           String?
  isDemoData      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  school      School       @relation(fields: [schoolId], references: [id])
  enrollments Enrollment[]
  measurementSubmissions MeasurementSubmission[]
  measurements           Measurement[]

  @@unique([businessId, permanentId])
  @@index([businessId, schoolId])
  @@index([businessId, name])
  @@index([businessId, status])
}

model Enrollment {
  id             String   @id @default(uuid())
  businessId     String
  studentId      String
  schoolId       String
  academicYearId String
  classId        String
  divisionId     String?
  rollNumber     String?
  status         String   @default("enrolled")
  isDemoData     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business     Business        @relation(fields: [businessId], references: [id])
  student      Student         @relation(fields: [studentId], references: [id])
  school       School          @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear    @relation(fields: [academicYearId], references: [id])
  class        SchoolClass     @relation(fields: [classId], references: [id])
  division     SchoolDivision? @relation(fields: [divisionId], references: [id])
  measurementSubmissions MeasurementSubmission[]

  @@unique([businessId, academicYearId, studentId])
  @@index([businessId, schoolId])
  @@index([businessId, studentId])
  @@index([academicYearId])
  @@index([classId])
  @@index([divisionId])
}

model Product {
  id                String   @id @default(uuid())
  businessId        String
  name              String
  sku               String
  description       String?
  category          String
  fabricType        String?
  color             String?
  variants          Json?
  unit              String   @default("PCS")
  costPrice         Decimal  @db.Decimal(12, 2)
  sellingPrice      Decimal  @db.Decimal(12, 2)
  imageUrl          String?
  thumbnailUrl      String?
  hasStandardSize   Boolean  @default(false)
  sizeChart         Json?
  measurementFields Json?
  isActive          Boolean  @default(true)
  isDemoData        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business       Business       @relation(fields: [businessId], references: [id])
  schoolProducts SchoolProduct[]
  measurements   Measurement[]

  @@unique([businessId, sku])
  @@index([businessId, category])
  @@index([businessId, isActive])
}

model SchoolProduct {
  id                    String   @id @default(uuid())
  businessId            String
  schoolId              String
  academicYearId        String
  productId             String
  priceOverride         Decimal? @db.Decimal(12, 2)
  applicableClassIds    Json?
  applicableDivisionIds Json?
  uniformCategories     Json?
  isMandatory           Boolean  @default(true)
  isActive              Boolean  @default(true)
  isDemoData            Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business     Business     @relation(fields: [businessId], references: [id])
  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@unique([businessId, schoolId, academicYearId, productId])
  @@index([businessId, schoolId])
  @@index([businessId, productId])
  @@index([academicYearId])
}

// ============================================================
// PHASE 2 — MEASUREMENT COLLECTION
// ============================================================

model MeasurementSubmission {
  id              String    @id @default(uuid())
  businessId      String
  schoolId        String
  academicYearId  String
  studentId       String
  enrollmentId    String?
  tokenHash       String?   @unique
  tokenExpiresAt  DateTime?
  tokenRevoked    Boolean   @default(false)
  status          String    @default("LINK_NOT_GENERATED")
  submittedAt     DateTime?
  verifiedById    String?
  verifiedAt      DateTime?
  rejectionReason String?
  submissionData  Json?
  lastSentAt      DateTime?
  sendCount       Int       @default(0)
  isDemoData      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business     Business      @relation(fields: [businessId], references: [id])
  school       School        @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  student      Student       @relation(fields: [studentId], references: [id])
  enrollment   Enrollment?   @relation(fields: [enrollmentId], references: [id])
  verifiedBy   User?         @relation("MeasurementVerifier", fields: [verifiedById], references: [id])
  measurements Measurement[]

  @@unique([businessId, academicYearId, studentId])
  @@index([businessId, schoolId, status])
  @@index([businessId, status])
  @@index([academicYearId])
}

model Measurement {
  id             String   @id @default(uuid())
  businessId     String
  studentId      String
  academicYearId String
  productId      String
  submissionId   String?
  source         String   @default("SELF_SERVICE")
  size           String?
  fields         Json?
  notes          String?
  isDemoData     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business     Business               @relation(fields: [businessId], references: [id])
  student      Student                @relation(fields: [studentId], references: [id])
  academicYear AcademicYear           @relation(fields: [academicYearId], references: [id])
  product      Product                @relation(fields: [productId], references: [id])
  submission   MeasurementSubmission? @relation(fields: [submissionId], references: [id])
  history      MeasurementHistory[]

  @@unique([businessId, studentId, academicYearId, productId])
  @@index([businessId, academicYearId])
  @@index([studentId])
  @@index([productId])
}

model MeasurementHistory {
  id            String   @id @default(uuid())
  businessId    String
  measurementId String
  changedById   String?
  changedByName String
  changeType    String
  before        Json?
  after         Json?
  reason        String?
  createdAt     DateTime @default(now())

  business    Business    @relation(fields: [businessId], references: [id])
  measurement Measurement @relation(fields: [measurementId], references: [id])

  @@index([businessId, measurementId])
}

